# JARVIS - Student-Centric Permission-Aware Autonomous AI Agent Configuration Template

# AI Intelligence Providers
# Supported: "groq", "ollama", "openai", "fallback"
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local Offline Inference (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Advanced Voice Providers
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
ACADEMIC_SEARCH_API_KEY=your_academic_key_here
WAKE_WORD_ENABLED=true

# College LMS & Portal Configuration
LMS_DEFAULT_URL=https://lms.nec.edu.in/
LMS_PROVIDER=moodle
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=
